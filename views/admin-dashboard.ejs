
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LibTrack | Admin Dashboard</title>
    <link rel="stylesheet" href="/css/admin-dash.css">
</head>
<body>

    <%
        // Keys are normalized (lowercase, no leading "PHINMA"), so accounts
        // registered with either "PHINMA University of Iloilo" or the older
        // "University of Iloilo" both resolve to the same logo.
        const universityLogos = {
            'araullo university': '/images/phinma-au.png',
            'cagayan de oro college': '/images/phinma-coc.png',
            'university of pangasinan': '/images/phinma-upang.png',
            'university of iloilo': '/images/phinma-ui.jpg',
            'upang college urdaneta': '/images/phinma-urdaneta.jpg',
            'southwestern university phinma': '/images/phinma-swu.png',
            'saint jude college manila': '/images/phinma-sjc-manila.png',
            'saint jude college quezon city': '/images/phinma-sjc-qc.png',
            'rizal college of laguna': '/images/phinma-rcl.png',
            'union college of laguna': '/images/phinma-ucl.png',
            'saint jude college dasmariñas': '/images/phinma-sjc-dasma.jpg'
        };

        const normalizeUniversity = (name) => String(name || '')
            .normalize('NFC')
            .replace(/\s+/g, ' ')
            .trim()
            .toLowerCase()
            .replace(/^phinma\s+/, '');

        const logo = universityLogos[normalizeUniversity(university)];
    %>

    <header class="topbar">
        <a href="/admin-dashboard" class="brand">
            <% if (logo) { %>
                <img src="<%= logo %>" alt="University logo" class="university-logo">
            <% } %>

            <div class="brand-text">
                <h2>LibTrack</h2>
                <span>Library Visit Tracking System</span>
            </div>
        </a>

        <nav class="admin-nav">
            <a href="/admin-dashboard" class="active">Dashboard</a>
            <a href="/statistics">Statistics</a>
            <a href="/visit-records">Visit Records</a>
            <a href="/logout" class="logout-btn"
               onclick="return confirm('Are you sure you want to logout?')">
                Logout
            </a>
        </nav>
    </header>

    <main class="dashboard">

        <section class="welcome-section">
            <div>
                <p class="eyebrow">ADMINISTRATION</p>
                <h1>Admin Dashboard</h1>
                <p class="welcome-text">
                    Manage student library visits and monitor recent activity.
                </p>
            </div>

            <div class="university-label">
                <span class="status-dot"></span>
                <span><%= university %></span>
            </div>
        </section>

        <section class="dashboard-grid">

            <!-- Add Student -->
            <div class="card add-student">
                <div class="section-heading">
                    <div class="heading-icon">+</div>
                    <div>
                        <h2>Record a Visit</h2>
                        <p>Enter a student's school ID.</p>
                    </div>
                </div>

                <form action="/add-student" method="POST">
                    <label for="school_id">Student School ID</label>
                    <input
                        type="text"
                        id="school_id"
                        name="school_id"
                        placeholder="Enter school ID"
                        required
                    >
                    <button type="submit" class="primary-btn">
                        Record Student Visit
                    </button>
                </form>

                <p class="form-note">
                    Make sure the school ID belongs to a registered student.
                </p>
            </div>

            <!-- Student ID Scanner -->
            <div class="card scanner-card">
                <div class="section-heading">
                    <div class="heading-icon scanner-icon">ID</div>
                    <div>
                        <h2>Student ID Scanner</h2>
                        <p>Scan a printed student ID using your camera.</p>
                    </div>
                </div>

                <div class="camera-container">
                    <video
                        id="camera"
                        autoplay
                        playsinline
                        muted
                    ></video>

                    <div class="camera-placeholder">
                        Camera preview will appear here.
                    </div>
                </div>

                <button type="button" id="scanBtn" class="primary-btn" disabled>
                    Scan Student ID
                </button>

                <canvas id="canvas" hidden></canvas>
                <p id="result" class="scanner-result">Opening camera...</p>
            </div>

        </section>

        <!-- Recently Visited -->
        <section class="card visits-card">
            <div class="visits-heading">
                <div>
                    <p class="eyebrow">LIBRARY ACTIVITY</p>
                    <h2>Recently Visited</h2>
                    <p class="muted-text">
                        Student visits recorded today.
                    </p>
                </div>

                <a href="/visit-records" class="secondary-btn">
                    View All Records
                </a>
            </div>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>School ID</th>
                            <th>Student Name</th>
                            <th>Course</th>
                            <th>Year Level</th>
                            <th>Visit Time</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (students && students.length > 0) { %>
                            <% students.forEach(data => { %>
                                <tr>
                                    <td>
                                        <span class="school-id">
                                            <%= data.school_id %>
                                        </span>
                                    </td>
                                    <td class="student-name">
                                        <%= data.fullname %>
                                    </td>
                                    <td>
                                        <span class="course-badge">
                                            <%= data.course_code %>
                                        </span>
                                    </td>
                                    <td>Year <%= data.year_level %></td>
                                    <td class="visit-time">
                                        <%= new Date(data.time_visit).toLocaleTimeString('en-US', {
                                            hour: '2-digit',
                                            minute: '2-digit',
                                            hour12: true
                                        }) %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="empty-state">
                                    <div class="empty-icon">—</div>
                                    <strong>No visits recorded today</strong>
                                    <p>Student visits will appear here once recorded.</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <div class="table-footer">
                Showing today's recorded visits
            </div>
        </section>

        <footer class="dashboard-footer">
            <p>LibTrack &copy; 2026 | Library Visit Tracking System</p>
        </footer>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
    <script src="/camera.js"></script>
    <script src="/scanner.js"></script>

</body>
</html>
