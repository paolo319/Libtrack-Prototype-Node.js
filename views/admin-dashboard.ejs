<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
</head>
<body>
    <h1>Admin Dashboard</h1>

    <div class="admin-actions">
        <a href="/add-course">Add Course</a>
        <a href="/statistics">Statistics</a>
        <a href="/visit-records">Download Hardcopy</a>
        <a href="/logout" onclick="return confirm('Are you sure you want to logout?')">Logout</a>
    </div>

<section class="add-student">
    <h2>Add Student</h2>

    <form action="/add-student" method="POST">
        <label for="school_id">School ID</label>
        <input type="text" id="school_id" name="school_id" placeholder="Enter school ID" required>
        <button type="submit">Add Student</button>
    </form>
</section>


<!-- Paolo Montalban -->
<!-- Student ID Scanner -->
<section>
    <h2>Student ID Scanner</h2>

    <p>Place the printed student ID in front of the camera.</p>
    <video
    id="camera"
    width="400"
    height="300"
    autoplay
    playsinline
    muted
    style="background: #222;"></video>
    <br><br>
    <button type="button" id="scanBtn" disabled>Scan Student ID</button>
    
    <canvas id="canvas" hidden></canvas>
    <p id="result">Opening camera...</p>
</section>

<!--Paolo Montalban-->
<!---Paolo-->
<div class="student-list">
    <h2>Recently Visited</h2>

    <% if (students && students.length > 0) { %>
        <% students.forEach(data => { %>
            <p>
                <%= data.school_id %> -
                <%= data.fullname %> -
                <%= data.course_code %> -
                Year Level: <%= data.year_level %> -
                <%= new Date(data.time_visit).toLocaleTimeString('en-US', {
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: true
                }) %>
            </p>
        <% }) %>
    <% } else { %>
        <p>No recent visits found.</p>
    <% } %>
</div>
<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
<script src="/camera.js"></script>
<script src="/scanner.js"></script>
<!---Paolo Montalban-->
</body>
</html>